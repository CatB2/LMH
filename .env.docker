# ============================================
# SuperBizAgent Docker 部署配置
# ============================================
# 使用方法：docker compose --env-file .env.docker up -d

# ── 应用配置 ──
APP_NAME=SuperBizAgent
DEBUG=False
HOST=0.0.0.0
PORT=9900

# ── DashScope 配置（阿里云百炼）──
DASHSCOPE_API_KEY=sk-cb9cf6dd2dab4e05b23f31fc43795a9e
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-max
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_EMBEDDING_API_KEY=sk-cb9cf6dd2dab4e05b23f31fc43795a9e

# ── Milvus 配置 ──
# Docker 内使用服务名
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_TIMEOUT=10000

# ── Redis 配置 ──
REDIS_ENABLED=True
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_TTL_DAYS=7

# ── RAG 配置 ──
RAG_TOP_K=20
RAG_MODEL=qwen-max

# ── 文档分块 ──
CHUNK_MAX_SIZE=800
CHUNK_OVERLAP=100

# ── MCP 服务配置 ──
MCP_CLS_TRANSPORT=streamable-http
MCP_CLS_URL=http://mcp-cls:8003/mcp
MCP_MONITOR_TRANSPORT=streamable-http
MCP_MONITOR_URL=http://mcp-monitor:8004/mcp

# ── JWT 配置 ──
# ⚠️ 生产环境务必修改为随机字符串！
JWT_SECRET_KEY=super-biz-agent-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── 腾讯云 CLS 配置（可选）──
CLS_SECRET_ID=
CLS_SECRET_KEY=
CLS_REGION=ap-beijing
CLS_TOPIC_ID=
